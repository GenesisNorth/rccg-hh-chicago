# ─────────────────────────────────────────────────────────────
# RCCG Halleluyah House — environment
#
# The site has no database and no auth. The only backend is
# /api/forms, which emails contact / prayer / testimony / salvation
# submissions to the church inbox, gated by a reCAPTCHA checkbox.
# ─────────────────────────────────────────────────────────────

# Where every form submission is delivered.
CHURCH_INBOX_EMAIL=lightseedfellows@gmail.com

# The "From" address on those notification emails. Must be a domain
# verified in Resend, or the account used for SMTP.
EMAIL_FROM="RCCG Halleluyah House <onboarding@resend.dev>"

# ── Mail transport: pick ONE ─────────────────────────────────

# Option A — Resend (recommended). Sign up at resend.com, create an
# API key, and paste it here. Nothing else to configure.
RESEND_API_KEY=

# Option B — SMTP (e.g. Gmail with an App Password, not your login password:
# https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=lightseedfellows@gmail.com
# SMTP_PASSWORD=

# ── Spam protection (reCAPTCHA v2 "I'm not a robot" checkbox) ──
# Get both at https://www.google.com/recaptcha/admin — register a site,
# choose "reCAPTCHA v2 — I'm not a robot Checkbox", and add both your
# production domain and "localhost" so it works in local dev too.
# Site Key is public (safe to expose to the browser); Secret Key must stay
# private. Leave both blank and forms submit without a captcha step.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Public site URL — used for absolute links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
